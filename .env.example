# ─────────────────────────────────────────────────────────────
# Prisma.AI — variáveis de ambiente para execução local
# Copie este arquivo para .env e ajuste os valores.
# ─────────────────────────────────────────────────────────────

# Banco de dados PostgreSQL
POSTGRES_USER=ell_user
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=ell_ibm

# Porta exposta no host. Use 5433 se 5432 já estiver ocupada.
POSTGRES_HOST_PORT=5432

# URL usada pelo backend dentro do Docker Compose.
# O host "postgres" é o nome do serviço no Compose.
# A senha e o usuário devem ser iguais aos definidos acima.
DATABASE_URL=postgresql+asyncpg://ell_user:troque-esta-senha@postgres:5432/ell_ibm

# Opcional (Neon/Render): URL direta, sem pooler, usada por migrations.
# DATABASE_URL_UNPOOLED=

# Aplicação
ENVIRONMENT=development
SECRET_KEY=troque-por-uma-chave-aleatoria-com-32-caracteres-ou-mais
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=http://localhost:5173
SQL_ECHO=false

# E-mail
# Com REQUIRE_EMAIL_VERIFICATION=false, o cadastro já cria a conta verificada
# e o usuário entra direto. Quando true, o token é enviado por e-mail.
REQUIRE_EMAIL_VERIFICATION=false
# Com MAIL_ENABLED=false, os tokens são impressos no log do backend.
MAIL_ENABLED=false
MAIL_FROM=noreply@ell-ibm.local
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TLS=true

# IBM watsonx Orchestrate
# Liga/desliga a integração globalmente. false = fallback determinístico em todos os agentes.
ORCHESTRATE_ENABLED=false
ORCHESTRATE_URL=
ORCHESTRATE_API_KEY=
# Legado — mantido para compatibilidade.
ORCHESTRATE_AGENT_ID=
# UUIDs dos agentes — obter com: orchestrate agents list -v
ORCHESTRATE_AGENT_MENTOR_ID=
ORCHESTRATE_CATALYST_AGENT_ID=
ORCHESTRATE_ANALYST_AGENT_ID=
ORCHESTRATE_STUDIO_AGENT_ID=
ORCHESTRATE_TIMEOUT_SECONDS=15
# Flags por agente (opcional). Quando omitida, usa ORCHESTRATE_ENABLED.
# Use para rollout gradual: ligar um agente sem ligar os demais.
# ORCHESTRATE_MENTOR_ENABLED=false
# ORCHESTRATE_CATALYST_ENABLED=false
# ORCHESTRATE_ANALYST_ENABLED=false
# Estúdio: mantenha false até existir um agente de geração de conteúdo.
# Com false, /studio/generate devolve 503 sem cobrar Prismas.
ORCHESTRATE_STUDIO_ENABLED=false

# Frontend (opcional; o padrão já aponta para a API local)
VITE_API_BASE_URL=http://localhost:8000
